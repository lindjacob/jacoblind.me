# Normalize all text files to LF in the repo, regardless of contributor OS.
# Working-directory line endings are left to each editor / git config.
* text=auto eol=lf

# Common binary assets — declared explicitly so Git never tries to diff or normalize them.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.svg  text eol=lf
*.pdf  binary
*.zip  binary
*.woff  binary
*.woff2 binary
*.ttf  binary
*.eot  binary
